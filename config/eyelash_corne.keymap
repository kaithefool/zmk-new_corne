#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E         &kp R  &kp T                                       &mmv MOVE_UP                     &kp Y      &kp U  &kp I          &kp O    &kp P     &kp ENTER
&kp LEFT_CONTROL  &kp A  &kp S  &kp D         &kp F  &kp G                       &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp H      &kp J  &kp K          &kp L    &kp SEMI  &kp RCTRL
&kp LEFT_SHIFT    &kp Z  &kp X  &kp C         &kp V  &kp B         &kp C_MUTE                    &mmv MOVE_DOWN                   &kp N      &kp M  &kp COMMA      &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                &kp LEFT_ALT  &mo 2  &kp LEFT_GUI                                                                 &kp SPACE  &mo 1  &kp BACKSPACE
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOLUME_DOWN>,
                <&rsr_trans>;
        };

        lower_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp N1     &kp N2     &kp N3            &kp N4             &kp N5                                       &mmv MOVE_UP                     &kp N6      &kp N7    &kp N8         &kp N9        &kp N0     &trans
&trans  &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp DELETE  &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &trans
&trans  &none      &none      &kp SQT           &kp GRAVE          &none          &kp C_MUTE                    &mmv MOVE_DOWN                   &kp INSERT  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &trans
                              &trans            &mo 3              &trans                                                                        &trans      &trans    &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&kp ESCAPE    &kp EXCL        &kp AT    &kp HASH           &kp DLLR         &kp PRCNT                            &mmv MOVE_UP                     &kp CARET  &kp AMPS              &kp ASTRK               &kp LPAR           &kp RPAR               &trans
&kp CAPSLOCK  &kp UNDERSCORE  &kp PLUS  &kp LEFT_BRACE     &kp RIGHT_BRACE  &kp PIPE             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none      &kp LG(LEFT_BRACKET)  &kp LS(LC(LEFT_ARROW))  &kp LS(LC(RIGHT))  &kp LG(RIGHT_BRACKET)  &trans
&trans        &none           &none     &kp DOUBLE_QUOTES  &kp TILDE        &none      &trans                    &mmv MOVE_DOWN                   &none      &none                 &none                   &none              &none                  &trans
                                        &trans             &trans           &trans                                                                &trans     &mo 3                 &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        func_layer {
            display-name = "Fn";
            bindings = <
&kp F11  &kp F1     &kp F2             &kp F3      &kp F4           &kp F5                               &mmv MOVE_UP                     &kp F6  &kp F7          &kp F8          &kp F9          &kp F10          &kp F12
&trans   &mkp LCLK  &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &mkp RCLK            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &trans
&trans   &none      &kp C_PREV         &kp C_PLAY  &kp C_NEXT       &none      &trans                    &mmv MOVE_DOWN                   &trans  &trans          &msc SCRL_UP    &msc SCRL_DOWN  &trans           &trans
                                       &trans      &trans           &trans                                                                &trans  &trans          &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
